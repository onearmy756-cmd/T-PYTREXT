{
  "productName": "{project_name}",
  "version": "0.1.0",
  "identifier": "com.{project_name}.app",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "{project_name}",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
