{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MBILINYITECH IDE",
  "version": "0.1.0",
  "identifier": "tech.mbilinyi.mtechos.ide",
  "build": {
    "frontendDist": "../../server/agent/static",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MBILINYITECH IDE",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "url": "boot-canvas.html",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "MBILINYITECH IDE — Monaco + Zed UI + Rust agent",
    "longDescription": "Desktop shell (Tauri 2) for MTECHOS IDE. UI remains the same; Rust agent provides /api/* backend."
  },
  "plugins": {}
}
