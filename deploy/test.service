[Unit]
Description=PyTreXT test Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=pytrex
Group=pytrex
WorkingDirectory=/opt/test
ExecStart=/opt/test/run.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=test

# Environment
Environment=PYTREX_ENV=production
Environment=PYTREX_PORT=9000
Environment=PYTREX_LOG_LEVEL=INFO
EnvironmentFile=-/etc/test/env

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/test /data
ReadOnlyPaths=/usr /etc/test
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=yes
MemoryLimit=512M

[Install]
WantedBy=multi-user.target
